rules_version = '2';

// Paste this into Firebase console -> Firestore Database -> Rules -> Publish.
// Each student can read and write only their own account data.
// You (the project owner) can still see everything in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /data/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid
                           && docId in ['attempts', 'tests'];
      }
    }
  }
}
