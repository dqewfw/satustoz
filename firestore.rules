rules_version = '2';

// Paste this into Firebase console -> Firestore Database -> Rules -> Publish.
// Each student can read and write only their own account data.
// You (the project owner) can still see and edit everything in the Firebase console.
//
// The plan fields (plan, planUntil, planSource) are read-only for students:
// only you, in the console, or your payment Worker (which uses a service
// account and skips these rules) can set them. Without this, anyone could
// give themselves Pro from the browser console.
//
// payments/<orderId> (one document per Payme payment) is written only by the
// payment Worker. No rule below matches it, so students can't read or write it.
service cloud.firestore {
  match /databases/{database}/documents {
    function planFields() { return ['plan', 'planUntil', 'planSource']; }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(planFields());
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(planFields());

      match /data/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid
                           && docId in ['attempts', 'tests'];
      }
    }
  }
}
