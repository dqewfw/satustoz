rules_version = '2';

// Paste this into Firebase console -> Firestore Database -> Rules -> Publish.
// Each student can read and write only their own account data.
// You (the project owner) can still see and edit everything in the Firebase console.
//
// The plan fields (plan, planUntil, planSource) are read-only for students:
// only an admin on admin.html (see adminEmails() below), you in the console, or
// your payment Worker (which uses a service account and skips these rules) can
// set them. Without this, anyone could give themselves Pro from the browser console.
//
// payments/<orderId> (one document per Payme payment) is written only by the
// payment Worker. No rule below matches it, so students can't read or write it.
//
// payRequests/<uid> is a student's "I paid by card transfer" note (MANUAL_PAY in
// assets/sh.js), one per student. Students can write only their own, under their
// own sign-in email, and can't delete it. Writing it changes nothing by itself:
// Pro switches on only when an admin approves it on admin.html (or you set the
// plan fields in the console).
//
// Newer collections (README "Study tools, classes and the national mock"):
// users/<uid>/data/study (mistake notebook, vocabulary, daily question...),
// users/<uid>/notices (e.g. "your report was fixed"), referrals, realScores,
// teachers, classes (+ members, assignments, results), classCodes, mocks and
// mockResults. Publish this whole file again after every update.
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------------------
    // ADMINS: FILL THIS IN. The Google accounts that may use admin.html to
    // approve card transfers. Replace the placeholder with your Google email,
    // in lowercase, exactly as Firebase -> Authentication -> Users shows it.
    // More than one: ['you@gmail.com', 'partner@gmail.com'].
    // While the placeholder is here, nobody is an admin and admin.html can't
    // load anything.
    // ---------------------------------------------------------------------
    function adminEmails() { return ['zizz83318@gmail.com']; }

    // Signed in with one of the emails above, and Google has checked that the
    // account really owns that email.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() in adminEmails();
    }

    function planFields() { return ['plan', 'planUntil', 'planSource']; }

    // The plan fields an admin writes to users/<uid>, as admin.html writes them.
    function validPlan() {
      let d = request.resource.data;
      return (!('plan' in d) || d.plan in ['free', 'pro', 'max'])
          && (!('planUntil' in d) || d.planUntil is timestamp)
          && (!('planSource' in d) || (d.planSource is string && d.planSource.size() <= 20));
    }

    function validPayRequest(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'email', 'name', 'plan', 'amount', 'months', 'last4', 'receiptId', 'lang', 'createdAt'])
          && d.keys().hasAll(['uid', 'email', 'plan', 'amount', 'last4', 'createdAt'])
          && d.uid == uid
          && d.email == request.auth.token.email
          && d.plan in ['pro', 'max']
          && d.amount is int && d.amount >= 0
          && (!('months' in d) || (d.months is int && d.months >= 1 && d.months <= 12))
          && d.last4 is string && d.last4.matches('[0-9]{4}')
          && (!('receiptId' in d) || (d.receiptId is string && d.receiptId.size() <= 60))
          && (!('name' in d) || (d.name is string && d.name.size() <= 100))
          && (!('lang' in d) || d.lang in ['en', 'uz', 'ru'])
          && d.createdAt == request.time;
    }

    // waitlist/<uid>: a student's Telegram username for the Max waitlist
    // (the Max card on the plans). Students write only their own.
    function validWaitlist(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'email', 'name', 'telegram', 'lang', 'createdAt'])
          && d.keys().hasAll(['uid', 'email', 'telegram', 'createdAt'])
          && d.uid == uid
          && d.email == request.auth.token.email
          && d.telegram is string && d.telegram.matches('@[A-Za-z0-9_]{5,32}')
          && (!('name' in d) || (d.name is string && d.name.size() <= 100))
          && (!('lang' in d) || d.lang in ['en', 'uz', 'ru'])
          && d.createdAt == request.time;
    }

    // reports/<auto id>: "Report a mistake" on a question, or "Send feedback".
    // Any signed-in student can add one under their own uid; only an admin
    // (admin.html) can read or delete them.
    function validReport() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'email', 'name', 'kind', 'qid', 'where', 'text', 'quoteOk', 'lang', 'page', 'createdAt'])
          && d.keys().hasAll(['uid', 'kind', 'text', 'createdAt'])
          && d.uid == request.auth.uid
          && (!('email' in d) || d.email == request.auth.token.email || d.email == '')
          && d.kind in ['mistake', 'feedback']
          && d.text is string && d.text.size() >= 3 && d.text.size() <= 1000
          && (!('qid' in d) || (d.qid is string && d.qid.size() <= 100))
          && (!('where' in d) || (d.where is string && d.where.size() <= 120))
          && (!('name' in d) || (d.name is string && d.name.size() <= 100))
          && (!('quoteOk' in d) || d.quoteOk is bool)
          && (!('lang' in d) || d.lang in ['en', 'uz', 'ru'])
          && (!('page' in d) || (d.page is string && d.page.size() <= 60))
          && d.createdAt == request.time;
    }

    // ---------------------------------------------------------------------
    // Referrals: referrals/<friend uid> is written by the friend once they
    // finish the free diagnostic, naming the same inviter their account was
    // created with (users.referredBy). The inviter can see their own; only an
    // admin marks them rewarded (admin.html adds 7 days of Pro).
    // ---------------------------------------------------------------------
    function validReferral(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'referrer', 'name', 'email', 'testId', 'createdAt'])
          && d.uid == uid
          && d.referrer is string && d.referrer.matches('[A-Za-z0-9]{10,40}') && d.referrer != uid
          && get(/databases/$(database)/documents/users/$(uid)).data.get('referredBy', '') == d.referrer
          && (!('name' in d) || (d.name is string && d.name.size() <= 100))
          && (!('email' in d) || d.email == request.auth.token.email || d.email == '')
          && (!('testId' in d) || (d.testId is string && d.testId.size() <= 60))
          && d.createdAt == request.time;
    }
    match /referrals/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid && validReferral(uid);
      allow get: if request.auth != null && (request.auth.uid == uid || resource.data.referrer == request.auth.uid);
      allow list: if request.auth != null && resource.data.referrer == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // realScores/<uid>: "Took the real SAT?", next to their practice scores.
    function validRealScore(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'email', 'total', 'rw', 'math', 'month', 'practiceBest', 'practiceLast', 'practiceAvg3', 'practiceTests', 'createdAt'])
          && d.uid == uid
          && d.rw is int && d.rw >= 200 && d.rw <= 800
          && d.math is int && d.math >= 200 && d.math <= 800
          && d.total == d.rw + d.math
          && d.month is string && d.month.matches('20[0-9]{2}-[0-9]{2}')
          && (!('name' in d) || (d.name is string && d.name.size() <= 100))
          && d.createdAt == request.time;
    }
    match /realScores/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && validRealScore(uid);
      allow read, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Teachers and classes (teacher.html). teachers/<email in lowercase> is
    // added by an admin on admin.html (the center plan). A teacher creates
    // classes; students join with the class code (classCodes/<code>).
    // ---------------------------------------------------------------------
    function isTeacher() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email.lower()));
    }
    function classOwner(cid) {
      return request.auth != null && get(/databases/$(database)/documents/classes/$(cid)).data.owner == request.auth.uid;
    }
    function isMember(cid) {
      return request.auth != null && exists(/databases/$(database)/documents/classes/$(cid)/members/$(request.auth.uid));
    }
    match /teachers/{email} {
      allow get: if request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() == email;
      allow read, write: if isAdmin();
    }
    match /classCodes/{code} {
      allow get: if request.auth != null;
      allow create: if isTeacher()
                    && request.resource.data.keys().hasOnly(['classId', 'name', 'teacher', 'center', 'owner'])
                    && request.resource.data.owner == request.auth.uid
                    && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.owner == request.auth.uid
                    && code.matches('[A-Z0-9]{5,12}');
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    match /classes/{cid} {
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow get: if request.auth != null && (resource.data.owner == request.auth.uid || isMember(cid) || isAdmin());
      allow create: if isTeacher()
                    && request.resource.data.keys().hasOnly(['owner', 'ownerEmail', 'teacher', 'center', 'name', 'code', 'createdAt'])
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.name is string && request.resource.data.name.size() <= 60
                    && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'archived']);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /members/{uid} {
        allow read: if classOwner(cid) || (request.auth != null && request.auth.uid == uid);
        allow create: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'stats', 'joinedAt', 'updatedAt'])
                      && request.resource.data.uid == uid
                      && (!('stats' in request.resource.data) || request.resource.data.stats is map)
                      && request.resource.data.joinedAt == request.time
                      && !get(/databases/$(database)/documents/classes/$(cid)).data.get('archived', false);
        allow update: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'stats', 'updatedAt'])
                      && request.resource.data.stats is map;
        allow delete: if (request.auth != null && request.auth.uid == uid) || classOwner(cid);
      }
      match /assignments/{aid} {
        allow read: if classOwner(cid) || isMember(cid);
        allow create, update: if classOwner(cid)
                      && request.resource.data.keys().hasOnly(['kind', 'ref', 'title', 'due', 'drill', 'createdAt'])
                      && request.resource.data.kind in ['set', 'test', 'lesson', 'drill']
                      && request.resource.data.title is string && request.resource.data.title.size() <= 80;
        allow delete: if classOwner(cid);
      }
      match /results/{rid} {
        allow read: if classOwner(cid) || (request.auth != null && resource.data.uid == request.auth.uid);
        allow create, update: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && rid == request.resource.data.aid + '_' + request.auth.uid
                      && isMember(cid)
                      && exists(/databases/$(database)/documents/classes/$(cid)/assignments/$(request.resource.data.aid))
                      && request.resource.data.keys().hasOnly(['aid', 'uid', 'name', 'title', 'correct', 'count', 'score', 'rw', 'math', 'finishedAt'])
                      && request.resource.data.finishedAt == request.time;
        allow delete: if classOwner(cid);
      }
    }

    // ---------------------------------------------------------------------
    // National mock: an admin schedules mocks/<id> on admin.html (test,
    // start, end). mockResults/<mock id>_<uid> is written once per student,
    // only while that mock is open (plus 4 hours to finish). Everyone can see
    // the leaderboard: first name and initial, region, school, score.
    // ---------------------------------------------------------------------
    match /mocks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    function validMockResult(rid) {
      let d = request.resource.data;
      let m = get(/databases/$(database)/documents/mocks/$(d.mockId)).data;
      return d.keys().hasOnly(['mockId', 'uid', 'name', 'region', 'school', 'total', 'rw', 'math', 'finishedAt'])
          && d.uid == request.auth.uid
          && rid == d.mockId + '_' + request.auth.uid
          && request.time >= m.startsAt && request.time <= m.endsAt + duration.value(4, 'h')
          && d.total is int && d.total >= 400 && d.total <= 1600
          && d.rw is int && d.math is int && d.total == d.rw + d.math
          && d.name is string && d.name.size() <= 40
          && d.region is string && d.region.size() <= 40
          && d.school is string && d.school.size() <= 80
          && d.finishedAt == request.time;
    }
    match /mockResults/{rid} {
      allow read: if true;
      allow create: if request.auth != null && validMockResult(rid);
      allow delete: if isAdmin();
    }

    match /reports/{id} {
      allow create: if request.auth != null && validReport();
      allow read, delete: if isAdmin();
    }

    match /waitlist/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && validWaitlist(uid);
      // Admin (admin.html): list everyone on the waitlist.
      allow read, delete: if isAdmin();
    }

    match /payRequests/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && validPayRequest(uid);

      // Admin (admin.html): list every request, and delete one once it is
      // approved or rejected.
      allow read, delete: if isAdmin();
    }

    // Fields a student can never change on their own account in a normal save:
    // the plan, and the record that they already used their 48-hour unlock.
    function lockedFields() { return planFields().concat(['trialUsedAt']); }

    // The 48-hour unlock (MANUAL_PAY in assets/sh.js): right after a student
    // sends a payment note (payRequests/<uid>, under 10 minutes old, for the
    // same plan) they may switch that plan on for at most 48 hours, once per
    // account, and only when no plan is running. You approve it on admin.html
    // (it becomes the full month) or reject it (it ends at once); if you do
    // neither, it simply runs out.
    function validTrial() {
      let d = request.resource.data;
      let before = resource.data;
      let note = /databases/$(database)/documents/payRequests/$(request.auth.uid);
      return d.diff(before).affectedKeys().hasOnly(['plan', 'planUntil', 'planSource', 'trialUsedAt'])
          && !('trialUsedAt' in before)
          && (!('plan' in before) || before.plan == 'free'
              || ('planUntil' in before && before.planUntil is timestamp && before.planUntil < request.time))
          && d.plan in ['pro', 'max']
          && d.planSource == 'pending'
          && d.planUntil is timestamp
          && d.planUntil > request.time
          && d.planUntil <= request.time + duration.value(48, 'h')
          && d.trialUsedAt == request.time
          && exists(note)
          && get(note).data.plan == d.plan
          && get(note).data.createdAt > request.time - duration.value(10, 'm');
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && !request.resource.data.keys().hasAny(lockedFields());
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(lockedFields())
                    && (!('referredBy' in resource.data) || request.resource.data.get('referredBy', '') == resource.data.referredBy);
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && validTrial();

      // Admin (admin.html): read one student's account, and change its plan
      // fields and nothing else. "create" is for a student whose account
      // document doesn't exist yet; it may hold only the plan fields.
      allow get: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(planFields())
                    && validPlan();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(planFields())
                    && validPlan();

      match /data/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid
                           && docId in ['attempts', 'tests', 'study'];
      }

      // "Your report on question X was fixed": written by an admin on admin.html.
      match /notices/{id} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if isAdmin()
                      && request.resource.data.keys().hasOnly(['kind', 'qid', 'where', 'text', 'createdAt'])
                      && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      }
    }
  }
}
